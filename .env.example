# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Controla si el proceso arranca como API, worker, o ambos
APP_ROLE=all   # web | worker | all

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev local: usa docker-compose.yml
DATABASE_URL=postgresql://plumia:plumia_dev@localhost:5432/plumia_development
# Prod: usar URL de Supabase (pooler mode para Railway)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
# Dev local: usa docker-compose.yml
REDIS_URL=redis://localhost:6379
# Prod: Upstash Redis URL
# REDIS_URL=rediss://default:[token]@[host].upstash.io:6379

# ─── Auth (Supabase) ──────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# ─── AI Providers ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# Embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# Generación de imágenes
FAL_API_KEY=

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=plumia-storage
R2_PUBLIC_URL=

# ─── Encryption (BYOK – AES-256-GCM) ─────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
