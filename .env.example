# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_ROLE=all   # web | worker | all

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev local: docker-compose.yml o supabase start
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54325/postgres
# Prod: usar URL de Supabase
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
# Dev local: usa docker-compose.yml
REDIS_URL=redis://localhost:6379
# Prod: Upstash Redis URL
# REDIS_URL=rediss://default:[token]@[host].upstash.io:6379

# ─── Firebase Admin ──────────────────────────────────────────────────────────
# Opción A: archivo de service account
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Opción B: variables inline (comentar GOOGLE_APPLICATION_CREDENTIALS si se usa esta)
# FIREBASE_PROJECT_ID=plumia-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@plumia-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ─── AI Providers ─────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_SUMMARY_MODEL=gemini-flash-latest
GEMINI_SUMMARY_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Chat sobre manuscrito y Wiki (reutiliza GEMINI_API_KEY si no se define otra)
GEMINI_CHAT_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
# Lista opcional, en orden, para fallback automatico ante 404/429/5xx
GEMINI_CHAT_MODELS=gemini-3.6-flash
GEMINI_CHAT_TIMEOUT_MS=45000
GEMINI_EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_TIMEOUT_MS=45000
# Embeddings (text-embedding-3-small)
OPENAI_API_KEY=
# Generación de imágenes
# Pollinations AI (free, default)
POLLINATIONS_MODEL=flux
POLLINATIONS_BASE_URL=https://image.pollinations.ai/p
# Optional: use an image-capable model (for example kontext) for variants
# with a reference image. Keep empty to preserve the free Flux flow.
POLLINATIONS_REFERENCE_MODEL=
POLLINATIONS_API_KEY=
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
# Fal.ai (pago, alternativa)
FAL_API_KEY=

# Entity extraction (Gemini SDK)
# Optional legacy/proxy override; normally leave empty.
ENTITY_EXTRACTION_BASE_URL=
ENTITY_EXTRACTION_API_KEY=
ENTITY_EXTRACTION_MODEL=gemini-2.5-flash
# Optional: leave empty to skip embedding-based resolution
ENTITY_EXTRACTION_EMBEDDING_MODEL=
ENTITY_EXTRACTION_TIMEOUT_MS=30000
ENTITY_EXTRACTION_POLL_MS=5000

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
# Configuración general
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Bucket: imágenes
R2_IMAGES_BUCKET=
# Bucket: versiones de proyectos
R2_VERSIONS_BUCKET=

# ─── Encryption (BYOK – AES-256-GCM) ─────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
