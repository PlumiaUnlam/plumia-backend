# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_ROLE=all   # web | worker | all
# Orígenes de navegador permitidos (protocolo + host + puerto), separados por
# coma en una sola línea. Si cambiás el host o el puerto del frontend, actualizá
# esta lista y reiniciá el backend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev local con docker-compose.yml (backend ejecutado desde el host)
DATABASE_URL=postgresql://plumia:plumia_dev@127.0.0.1:5432/plumia_development
DIRECT_URL=postgresql://plumia:plumia_dev@127.0.0.1:5432/plumia_development
# Prod: usar URL de Supabase
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
# Dev local: usa docker-compose.yml
REDIS_URL=redis://localhost:6379
# Prod: Upstash Redis URL
# REDIS_URL=rediss://default:[token]@[host].upstash.io:6379

# ─── Firebase Admin ──────────────────────────────────────────────────────────
# Opción A: archivo de service account
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Opción B: variables inline (comentar GOOGLE_APPLICATION_CREDENTIALS si se usa esta)
# FIREBASE_PROJECT_ID=plumia-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@plumia-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Transcripción local (reemplazable por un proveedor pago en producción)
STT_PROVIDER=local
# Fuera de Docker: http://127.0.0.1:8001. Compose lo reemplaza por http://whisper:8001.
LOCAL_WHISPER_URL=http://127.0.0.1:8001
LOCAL_WHISPER_LANGUAGE=es
LOCAL_WHISPER_TIMEOUT_MS=90000

# ── LLMs: cadenas de fallback centralizadas (src/ai/ai-chains.config.ts) ──
# Cada caso de uso prueba sus pasos en orden y pasa al siguiente si uno falla
# (error HTTP, timeout, JSON inválido o circuito abierto):
#   Anthropic (principal) > OpenRouter (modelos de otros proveedores, termina en
#   openrouter/free) > Gemini gratis (último recurso).
# Los pasos sin API key se saltean, así que con una sola key igual funciona.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Gemini (capa gratis): último recurso de cada cadena y ruta alternativa de embeddings
GEMINI_API_KEY=

# Opcional: reemplazar la cadena de un caso de uso ("proveedor:modelo" separados por coma).
# Proveedores: anthropic | openrouter | gemini. Ids de OpenRouter: https://openrouter.ai/models
# AI_CHAT_ANSWER_CHAIN=anthropic:claude-opus-5-5,openrouter:anthropic/claude-sonnet-5.5,openrouter:openai/gpt-6.1-sol,openrouter:google/gemini-3.8-flash,openrouter:deepseek/deepseek-v4-pro,openrouter:openrouter/free,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash
# AI_CHAT_INTENT_CHAIN=anthropic:claude-haiku-5-5,openrouter:google/gemini-3.6-flash,openrouter:openai/gpt-5.4-mini,openrouter:deepseek/deepseek-v4-flash,openrouter:openrouter/free,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite
# AI_CHAT_VERIFY_CHAIN=(igual que AI_CHAT_INTENT_CHAIN)
# AI_SUMMARY_CHAIN=anthropic:claude-haiku-5-5,openrouter:google/gemini-3.1-flash-lite,openrouter:openai/gpt-5.4-mini,openrouter:mistralai/mistral-small-2603,openrouter:deepseek/deepseek-v4-flash,openrouter:openrouter/free,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash
# AI_EXTRACTION_CHAIN=anthropic:claude-sonnet-5-5,openrouter:anthropic/claude-sonnet-5.5,openrouter:openai/gpt-6.1-sol,openrouter:google/gemini-3.6-flash,openrouter:deepseek/deepseek-v4-pro,openrouter:openrouter/free,gemini:gemini-3.6-flash,gemini:gemini-3.1-flash-lite
# Tiempos por caso de uso (ms): AI_<CASO>_STEP_TIMEOUT_MS (por intento) y AI_<CASO>_TOTAL_TIMEOUT_MS (toda la cadena)
# Esfuerzo de razonamiento: AI_<CASO>_EFFORT=low | medium | high

# Embeddings del índice vectorial. No pueden cambiar de modelo sin reindexar: todas
# las rutas sirven gemini-embedding-2 (1536 dims) y devuelven los mismos vectores.
# AI_EMBEDDING_CHAIN=openrouter:google/gemini-embedding-2,openrouter:google/gemini-embedding-2-preview,gemini:gemini-embedding-2,gemini:gemini-embedding-2-preview
# AI_EMBEDDING_STEP_TIMEOUT_MS=20000

# Generación de imágenes
# Valores: fal (recomendado) o pollinations (alternativa)
IMAGE_PROVIDER=fal

# Fal.ai
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro/edit
FAL_BASE_URL=https://queue.fal.run
FAL_TIMEOUT_MS=120000
FAL_POLL_INTERVAL_MS=1500

# Pollinations AI (se conserva como alternativa)
POLLINATIONS_MODEL=flux
POLLINATIONS_BASE_URL=https://image.pollinations.ai/p
POLLINATIONS_REFERENCE_MODEL=
POLLINATIONS_API_KEY=

IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# Entity extraction
# Proveedor/modelo por defecto (los usuarios pueden elegir otro en Ajustes de IA).
# Va primero; si falla sigue AI_EXTRACTION_CHAIN. Con la key personal de un usuario,
# los respaldos usan esa misma key con otros modelos del mismo proveedor.
# Proveedor: anthropic | gemini
ENTITY_EXTRACTION_PROVIDER=anthropic
ENTITY_EXTRACTION_MODEL=claude-sonnet-5-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
ENTITY_EXTRACTION_EFFORT=medium
# Key de Gemini cuando un usuario elige Gemini con credenciales del servidor
ENTITY_EXTRACTION_API_KEY=
# Etapa de similitud por embeddings: vacío = desactivada. Con cualquier valor
# (ej. gemini-embedding-2) usa la cadena de embeddings.
ENTITY_EXTRACTION_EMBEDDING_MODEL=
# Tiempo máximo por intento: Claude razona antes de responder
ENTITY_EXTRACTION_TIMEOUT_MS=120000
ENTITY_EXTRACTION_POLL_MS=5000

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
# Configuración general
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Bucket: imágenes
R2_IMAGES_BUCKET=
# Bucket: versiones de proyectos
R2_VERSIONS_BUCKET=

# ─── Encryption (BYOK – AES-256-GCM) ─────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
